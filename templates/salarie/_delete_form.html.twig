<form method="post" action="{{ path('app_salarie_delete', {'id': salarie.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer ce salarié ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ salarie.id) }}">
    <button class="btn btn-rouge">Supprimer le salarié</button>
</form>
