{% extends 'base.html.twig' %}

{% block title %}{{ 'recherche.titre'|trans }}{% endblock %}

{% block body %}
    <div class="recherche">
        <aside class="carte filtres">
            <h2>{{ 'recherche.filtres'|trans }}</h2>

            <form id="form-recherche" data-url="{{ path('app_recherche_resultats') }}" data-erreur="{{ 'recherche.erreur'|trans }}">
                <div class="champ">
                    <label for="filtre-site">{{ 'champ.site'|trans }}</label>
                    <select id="filtre-site" name="site">
                        <option value="">{{ 'recherche.tous_les_sites'|trans }}</option>
                        {% for site in sites %}
                            <option value="{{ site.id }}" {{ site.id == site_choisi ? 'selected' }}>{{ site.nom }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="champ">
                    <span class="titre-champ">{{ 'champ.competences'|trans }}</span>
                    <div class="choix choix-colonne">
                        {% for competence in competences %}
                            <div>
                                <input type="checkbox" id="comp-{{ competence.id }}" name="competences[]" value="{{ competence.id }}"
                                       {{ competence.id in competences_choisies ? 'checked' }}>
                                <label for="comp-{{ competence.id }}">{{ competence.libelleTraduit(app.request.locale) }}</label>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                <button type="reset" class="lien-reset">{{ 'recherche.reinitialiser'|trans }}</button>
            </form>
        </aside>

        <section class="resultats-zone">
            <div>
                <h1>{{ 'recherche.titre'|trans }}</h1>
                <p class="sous-titre">{{ 'recherche.sous_titre'|trans }}</p>
            </div>

            <div id="resultats">
                {{ include('recherche/_resultats.html.twig') }}
            </div>
        </section>
    </div>
{% endblock %}
