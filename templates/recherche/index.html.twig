{% extends 'base.html.twig' %}

{% block title %}Recherche de salariés{% endblock %}

{% block body %}
    <div class="recherche">
        <aside class="carte filtres">
            <h2>Filtres</h2>

            <form id="form-recherche" data-url="{{ path('app_recherche_resultats') }}">
                <div class="champ">
                    <label for="filtre-site">Site</label>
                    <select id="filtre-site" name="site">
                        <option value="">Tous les sites</option>
                        {% for site in sites %}
                            <option value="{{ site.id }}" {{ site.id == site_choisi ? 'selected' }}>{{ site.nom }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="champ">
                    <span class="titre-champ">Compétences</span>
                    <div class="choix choix-colonne">
                        {% for competence in competences %}
                            <div>
                                <input type="checkbox" id="comp-{{ competence.id }}" name="competences[]" value="{{ competence.id }}"
                                       {{ competence.id in competences_choisies ? 'checked' }}>
                                <label for="comp-{{ competence.id }}">{{ competence.libelle }}</label>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                <button type="reset" class="lien-reset">Réinitialiser les filtres</button>
            </form>
        </aside>

        <section class="resultats-zone">
            <div>
                <h1>Recherche de salariés</h1>
                <p class="sous-titre">Les résultats se mettent à jour à chaque changement de filtre.</p>
            </div>

            <div id="resultats">
                {{ include('recherche/_resultats.html.twig') }}
            </div>
        </section>
    </div>
{% endblock %}
